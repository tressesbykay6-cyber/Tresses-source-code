rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // All mutations go through the authenticated server API. Browser clients can
    // only read published content needed to render the public website.
    match /services/{document} { allow read: if true; allow write: if false; }
    match /stylists/{document} { allow read: if true; allow write: if false; }
    match /gallery/{document} { allow read: if true; allow write: if false; }
    match /settings/pageSettings { allow read: if true; allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
